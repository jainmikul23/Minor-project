    <!-- Client Script -->
    <script>
        // State
        let allDepartments = [];
        let loadedComplaints = [];
        let currentModalComplaintId = null;
        let debounceTimer = null;

        // Tab Navigation
        function switchTab(tabName) {
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.left-rail .action-btn').forEach(b => b.classList.remove('active'));

            const panel = document.getElementById('panel' + capitalize(tabName));
            const btn = document.getElementById('btnTab' + capitalize(tabName));

            if (panel) panel.classList.add('active');
            if (btn) btn.classList.add('active');

            window.location.hash = tabName;

            // Trigger specific loaders
            if (tabName === 'complaints') loadComplaints();
            if (tabName === 'officials') loadOfficials();
            if (tabName === 'workers') loadWorkers();
            if (tabName === 'citizens') loadCitizens();
            if (tabName === 'departments') loadDepartments();
            if (tabName === 'appointments') loadAdminAppointments();
            if (tabName === 'equity') setTimeout(loadEquityAnalytics, 100);
        }

        function capitalize(str) {
            return str.charAt(0).toUpperCase() + str.slice(1);
        }

        // Initialize on DOM load
        document.addEventListener('DOMContentLoaded', () => {
            loadInitialDepartments();
            loadOverviewStats();

            // Hash router
            const hash = window.location.hash.replace('#', '') || 'overview';
            switchTab(hash);
        });

        async function refreshAllData() {
            await loadOverviewStats();
            await loadInitialDepartments();
            showToast('Analytics and system data refreshed');
        }

        // 1. Overview Stats Loader
        async function loadOverviewStats() {
            try {
                const res = await fetch('/admin/api/stats');
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && data.overview) {
                        const o = data.overview;
                        document.getElementById('statTotalComplaints').textContent = o.total_complaints || 0;
                        document.getElementById('statReported').textContent = o.reported || 0;
                        document.getElementById('statInProgress').textContent = o.in_progress || 0;
                        document.getElementById('statResolved').textContent = o.resolved || 0;
                        document.getElementById('statRejected').textContent = o.rejected || 0;
                        document.getElementById('statCitizens').textContent = o.total_citizens || 0;
                        document.getElementById('statOfficials').textContent = o.total_officials || 0;
                        document.getElementById('statWorkers').textContent = o.total_workers || 0;
                    }

                    // Render Department Breakdown Table
                    if (data.departmentBreakdown) {
                        const tbody = document.getElementById('deptBreakdownTbody');
                        if (data.departmentBreakdown.length === 0) {
                            tbody.innerHTML = '<tr><td colspan="5" style="text-align: center; color: #94a3b8;">No departments configured.</td></tr>';
                        } else {
                            tbody.innerHTML = data.departmentBreakdown.map(dept => {
                                const total = parseInt(dept.complaint_count) || 0;
                                const resolved = parseInt(dept.resolved_count) || 0;
                                const pct = total > 0 ? Math.round((resolved / total) * 100) : 0;
                                return `
                                    <tr>
                                        <td style="font-weight: 600;">${escapeHtml(dept.department_name)}</td>
                                        <td>${total}</td>
                                        <td style="color: #047857; font-weight: 600;">${resolved}</td>
                                        <td style="color: #b45309; font-weight: 600;">${dept.in_progress_count || 0}</td>
                                        <td>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <div style="flex: 1; height: 6px; background: #e2e8f0; border-radius: 4px; overflow: hidden;">
                                                    <div style="width: ${pct}%; height: 100%; background: #10b981;"></div>
                                                </div>
                                                <span style="font-size: 11px; font-weight: 700;">${pct}%</span>
                                            </div>
                                        </td>
                                    </tr>
                                `;
                            }).join('');
                        }
                    }

                    // Render Recent Complaints List
                    if (data.recentComplaints) {
                        const list = document.getElementById('recentComplaintsList');
                        if (data.recentComplaints.length === 0) {
                            list.innerHTML = '<div style="text-align: center; color: #94a3b8; padding: 24px;">No recent complaints.</div>';
                        } else {
                            list.innerHTML = data.recentComplaints.map(c => `
                                <div style="display: flex; justify-content: space-between; align-items: center; padding: 12px; background: #f8fafc; border-radius: 10px; border: 1px solid #f1f5f9;">
                                    <div style="max-width: 70%;">
                                        <div style="font-weight: 600; font-size: 13.5px; color: var(--dark-gray); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                            #${c.complaint_id} - ${escapeHtml(c.description || 'No description')}
                                        </div>
                                        <div style="font-size: 11.5px; color: var(--gray); margin-top: 2px;">
                                            ${escapeHtml(c.department_name || 'General')} • By ${escapeHtml((c.citizen_first_name || '') + ' ' + (c.citizen_last_name || ''))}
                                        </div>
                                    </div>
                                    <span class="status-pill status-pill-${c.status}">${c.status}</span>
                                </div>
                            `).join('');
                        }
                    }
                }
            } catch (err) {
                console.error('Error loading overview stats:', err);
            }
        }

        // 2. Department Loader for Dropdowns
        async function loadInitialDepartments() {
            try {
                const res = await fetch('/admin/api/departments');
                if (res.ok) {
                    const data = await res.json();
                    if (data.success && data.departments) {
                        allDepartments = data.departments;

                        // Populate Filter Select
                        const filterSelect = document.getElementById('complaintDeptFilter');
                        const inlineSelect = document.getElementById('regDeptSelect');
                        const newWorkerDept = document.getElementById('newWorkerDept');

                        if (filterSelect) {
                            filterSelect.innerHTML = '<option value="all">All Departments</option>';
                            allDepartments.forEach(d => {
                                filterSelect.innerHTML += `<option value="${d.department_id}">${escapeHtml(d.Name)}</option>`;
                            });
                        }

                        if (inlineSelect) {
                            inlineSelect.innerHTML = '<option value="">-- Choose Department --</option>';
                            allDepartments.forEach(d => {
                                inlineSelect.innerHTML += `<option value="${d.department_id}">${d.department_id} - ${escapeHtml(d.Name)}</option>`;
                            });
                        }

                        if (newWorkerDept) {
                            newWorkerDept.innerHTML = '';
                            allDepartments.forEach(d => {
                                newWorkerDept.innerHTML += `<option value="${d.department_id}">${escapeHtml(d.Name)}</option>`;
                            });
                        }
                    }
                }
            } catch (e) {
                console.warn('Error loading departments:', e);
            }
        }

        // 3. Complaints Loader
        function debounceComplaintsLoad() {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(loadComplaints, 300);
        }

        async function loadComplaints() {
            const status = document.getElementById('complaintStatusFilter')?.value || 'all';
            const dept = document.getElementById('complaintDeptFilter')?.value || 'all';
            const search = document.getElementById('complaintSearchInput')?.value || '';

            const params = new URLSearchParams({ status, department_id: dept, search });
            const tbody = document.getElementById('complaintsTableBody');
            tbody.innerHTML = '<tr><td colspan="10" style="text-align: center; padding: 24px; color: #94a3b8;"><i class="fas fa-spinner fa-spin"></i> Filtering complaints...</td></tr>';

            try {
                const res = await fetch(`/admin/api/complaints?${params.toString()}`);
                if (res.ok) {
                    const data = await res.json();
                    loadedComplaints = data.complaints || [];
                    document.getElementById('complaintsCountBadge').textContent = `${loadedComplaints.length} Complaints Found`;

                    if (loadedComplaints.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="10" style="text-align: center; padding: 32px; color: #94a3b8;">No complaints matching current filters.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = loadedComplaints.map(c => {
                        const dateStr = c.created_at ? new Date(c.created_at).toLocaleDateString('en-IN') : 'N/A';
                        const citizenName = `${escapeHtml(c.user_first_name || '')} ${escapeHtml(c.user_last_name || '')}`.trim() || 'Anonymous';
                        const workerName = c.worker_first_name ? `${escapeHtml(c.worker_first_name)} ${escapeHtml(c.worker_last_name || '')}` : '<span style="color:#94a3b8;">Unassigned</span>';

                        const pScore = (c.priority_score !== undefined && c.priority_score !== null) ? Number(c.priority_score).toFixed(0) : '50';
                        const sev = c.severity || 'Medium';
                        let pBadgeClass = 'pill-p-med';
                        if (pScore >= 75) pBadgeClass = 'pill-p-critical';
                        else if (pScore >= 55) pBadgeClass = 'pill-p-high';
                        else if (pScore < 40) pBadgeClass = 'pill-p-low';

                        const otpBadge = c.otp_verified_at ? `
                            <div style="font-size: 11px; color: #047857; font-weight: 700; margin-top: 4px; display: flex; align-items: center; gap: 4px;">
                                <i class="fas fa-check-double"></i> OTP Verified
                            </div>
                        ` : c.resolution_otp ? `
                            <div style="font-size: 11px; color: #b45309; font-weight: 700; margin-top: 4px; display: flex; align-items: center; gap: 4px;">
                                <i class="fas fa-key"></i> OTP: <code>${escapeHtml(c.resolution_otp)}</code>
                            </div>
                        ` : '';

                        return `
                            <tr>
                                <td style="font-weight: 700;">#${c.complaint_id}</td>
                                <td><span style="font-weight: 600; color: var(--primary-blue);">${escapeHtml(c.department_name || 'General')}</span></td>
                                <td style="max-width: 200px;">
                                    <div style="font-weight: 600; font-size: 13px;">${escapeHtml(c.category_name || 'Civic Issue')}</div>
                                    <div style="font-size: 12px; color: var(--gray); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        ${escapeHtml(c.description || 'No description provided')}
                                    </div>
                                </td>
                                <td>
                                    <span class="priority-score-badge ${pBadgeClass}">
                                        <i class="fas fa-fire"></i> ${pScore} (${sev})
                                    </span>
                                    ${c.duplicates_count ? `<div style="font-size: 10.5px; color: #6366f1; margin-top: 2px;"><i class="fas fa-copy"></i> ${c.duplicates_count} similar</div>` : ''}
                                </td>
                                <td>
                                    <div style="font-weight: 600;">${citizenName}</div>
                                    <div style="font-size: 11px; color: var(--gray);">${escapeHtml(c.user_phone || '')}</div>
                                </td>
                                <td style="font-size: 12px; max-width: 140px;">
                                    ${escapeHtml(c.City || 'Indore')}, ${escapeHtml(c.Pincode || '')}
                                    <div style="font-size: 10.5px; color: var(--gray);">Ward ${escapeHtml(c.ward_no || '14')}</div>
                                </td>
                                <td>
                                    <span class="status-pill status-pill-${c.status}">${c.status}</span>
                                    ${otpBadge}
                                </td>
                                <td>${workerName}</td>
                                <td style="font-size: 12px; color: var(--gray);">${dateStr}</td>
                                <td>
                                    <button class="btn-action-sm btn-action-primary" onclick="inspectComplaint(${c.complaint_id})" title="Inspect and take action">
                                        <i class="fas fa-eye"></i> Manage
                                    </button>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error('Error loading complaints:', err);
                tbody.innerHTML = '<tr><td colspan="10" style="text-align: center; color: #ef4444; padding: 24px;">Failed to load complaints from database.</td></tr>';
            }
        }

        // 4. Modal Inspection & Management
        function inspectComplaint(id) {
            const complaint = loadedComplaints.find(c => c.complaint_id === id);
            if (!complaint) return;

            currentModalComplaintId = id;
            document.getElementById('modalComplaintTitle').innerHTML = `<i class="fas fa-file-invoice" style="color: var(--primary-blue); margin-right: 8px;"></i>Complaint #${id} - ${escapeHtml(complaint.department_name || 'Municipal Service')}`;

            const imgHtml = complaint.imageUrl ? `
                <div style="margin-bottom: 16px; border-radius: 12px; overflow: hidden; max-height: 220px; background: #000; text-align: center;">
                    <img src="${complaint.imageUrl}" style="max-height: 220px; max-width: 100%; object-fit: contain;">
                </div>
            ` : '';

            const slaDateStr = complaint.sla_due_at ? new Date(complaint.sla_due_at).toLocaleString('en-IN') : 'Standard 24h SLA';
            const workerFull = complaint.worker_first_name ? `${escapeHtml(complaint.worker_first_name)} ${escapeHtml(complaint.worker_last_name || '')} (${escapeHtml(complaint.worker_phone || 'N/A')})` : '<span style="color:#94a3b8;">Unassigned</span>';

            const proofPhotoHtml = complaint.proof_imageUrl ? `
                <div style="margin-top: 10px; padding: 10px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; display: flex; align-items: center; gap: 12px;">
                    <img src="${complaint.proof_imageUrl}" style="width: 70px; height: 70px; object-fit: cover; border-radius: 6px; cursor: pointer;" onclick="window.open('${complaint.proof_imageUrl}', '_blank')">
                    <div>
                        <div style="font-weight: 700; font-size: 13px; color: #047857;"><i class="fas fa-camera"></i> Field Worker Resolution Proof Photo</div>
                        <div style="font-size: 12px; color: #64748b;">GPS Distance: <strong>${complaint.proof_distance_meters !== null ? complaint.proof_distance_meters + 'm from incident' : 'Verified'}</strong></div>
                    </div>
                </div>
            ` : '';

            document.getElementById('modalComplaintBody').innerHTML = `
                ${imgHtml}
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px;">
                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; color: var(--gray); font-weight: 700;">Citizen</div>
                        <div style="font-weight: 600; font-size: 14px;">${escapeHtml(complaint.user_first_name || '')} ${escapeHtml(complaint.user_last_name || '')}</div>
                        <div style="font-size: 12px; color: var(--gray);">${escapeHtml(complaint.user_email || '')} • ${escapeHtml(complaint.user_phone || '')}</div>
                    </div>
                    <div>
                        <div style="font-size: 11px; text-transform: uppercase; color: var(--gray); font-weight: 700;">Location & Date</div>
                        <div style="font-size: 13.5px; font-weight: 600;">${escapeHtml(complaint.Address_Line || '')}, ${escapeHtml(complaint.City || 'Indore')}</div>
                        <div style="font-size: 12px; color: var(--gray);">Ward ${escapeHtml(complaint.ward_no || '14')} • PIN: ${escapeHtml(complaint.Pincode || '')} • ${dateStr}</div>
                    </div>
                </div>

                <!-- Research Paper Analytics Card -->
                <div style="background: linear-gradient(135deg, rgba(37,99,235,0.06), rgba(245,158,11,0.06)); border: 1px solid rgba(59,130,246,0.25); border-radius: 12px; padding: 12px 16px; margin-bottom: 16px;">
                    <div style="font-size: 11px; font-weight: 800; color: #1e3a8a; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 8px; display: flex; align-items: center; gap: 6px;">
                        <i class="fas fa-brain" style="color: #3b82f6;"></i> Research Paper Algorithmic Prioritisation P(i)
                    </div>
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; font-size: 12.5px;">
                        <div>
                            <span style="color: #64748b; font-size: 11px; display: block;">Priority Score:</span>
                            <strong style="color: #1e293b; font-size: 14px;">${complaint.priority_score || 50} / 100</strong> (${escapeHtml(complaint.severity || 'Medium')})
                        </div>
                        <div>
                            <span style="color: #64748b; font-size: 11px; display: block;">SLA Target:</span>
                            <strong style="color: #b45309;">${slaDateStr}</strong>
                        </div>
                        <div>
                            <span style="color: #64748b; font-size: 11px; display: block;">Similar Reports (D_i):</span>
                            <strong style="color: #6366f1;">${complaint.duplicates_count || 0} duplicates</strong>
                        </div>
                        <div>
                            <span style="color: #64748b; font-size: 11px; display: block;">Sensitive Zone (Z_i):</span>
                            <strong style="color: ${complaint.is_sensitive_zone ? '#ef4444' : '#10b981'};">${complaint.is_sensitive_zone ? 'Yes' : 'No'}</strong>
                        </div>
                    </div>
