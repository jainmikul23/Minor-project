<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Indore Municipal Corporation</title>
    <link rel="stylesheet" href="/user/styles/citizen.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Admin-specific enhancements: Ultra-stable non-overlapping CSS Grid */
        .main-container {
            display: grid !important;
            grid-template-columns: 280px minmax(0, 1fr) !important;
            width: 100% !important;
            min-height: calc(100vh - 74px) !important;
            position: relative !important;
            overflow-x: hidden !important;
            box-sizing: border-box !important;
        }

        .left-rail {
            grid-column: 1 !important;
            width: 280px !important;
            min-width: 280px !important;
            max-width: 280px !important;
            position: relative !important;
            z-index: 10 !important;
            overflow-y: auto !important;
            box-sizing: border-box !important;
            background: rgba(255, 255, 255, 0.88) !important;
            backdrop-filter: blur(24px) !important;
            -webkit-backdrop-filter: blur(24px) !important;
            border-right: 1px solid rgba(226, 232, 240, 0.8) !important;
        }

        .main-content, .center-content {
            grid-column: 2 !important;
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            padding: 24px 32px !important;
            overflow-y: auto !important;
            overflow-x: hidden !important;
            position: relative !important;
            z-index: 1 !important;
            box-sizing: border-box !important;
        }

        .stats-grid-compact {
            display: grid !important;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)) !important;
            gap: 16px !important;
            width: 100% !important;
            box-sizing: border-box !important;
            margin-bottom: 24px !important;
        }

        @media (max-width: 768px) {
            .main-container {
                display: flex !important;
                flex-direction: column !important;
            }
            .left-rail {
                width: 100% !important;
                min-width: 100% !important;
                max-width: 100% !important;
            }
            .main-content, .center-content {
                width: 100% !important;
                max-width: 100% !important;
                padding: 16px !important;
            }
        }

        .admin-badge-gold {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            padding: 3px 10px;
            border-radius: 999px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 2px 8px rgba(245, 158, 11, 0.35);
        }

        .portal-switcher-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.15);
            color: #ffffff;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
            border: 1px solid rgba(255, 255, 255, 0.25);
        }
        .portal-switcher-pill:hover {
            background: rgba(255, 255, 255, 0.25);
            transform: translateY(-1px);
        }

        .stats-grid-compact {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .admin-card {
            background: var(--card-glass, rgba(255, 255, 255, 0.85));
            backdrop-filter: blur(14px);
            border: 1px solid var(--card-border, rgba(255, 255, 255, 0.7));
            border-radius: 16px;
            padding: 22px;
            box-shadow: 0 10px 30px rgba(15, 23, 42, 0.05);
            transition: all 0.25s ease;
        }
        .admin-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.08);
        }

        .kpi-num {
            font-family: 'Outfit', sans-serif;
            font-size: 32px;
            font-weight: 800;
            color: var(--dark-gray);
            line-height: 1.1;
            margin-top: 8px;
        }

        .kpi-sub {
            font-size: 13px;
            color: var(--gray);
            margin-top: 4px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .tab-panel {
            display: none;
            animation: fadeInTab 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
        .tab-panel.active {
            display: block;
        }
        @keyframes fadeInTab {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Modern Data Table */
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            border-radius: 12px;
            border: 1px solid var(--border-color);
            background: #ffffff;
        }
        .admin-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13.5px;
            text-align: left;
        }
        .admin-table th {
            background: #f8fafc;
            color: var(--gray);
            font-weight: 600;
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 0.5px;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border-color);
        }
        .admin-table td {
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
            color: var(--dark-gray);
            vertical-align: middle;
        }
        .admin-table tr:hover td {
            background: #f8fafc;
        }
        .admin-table tr:last-child td {
            border-bottom: none;
        }

        /* Status Pills */
        .status-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 12px;
            font-weight: 600;
            text-transform: capitalize;
        }
        .status-pill-reported {
            background: #dbeafe;
            color: #1d4ed8;
        }
        .status-pill-in-progress {
            background: #fef3c7;
            color: #b45309;
        }
        .status-pill-resolved {
            background: #d1fae5;
            color: #047857;
        }
        .status-pill-rejected {
            background: #fee2e2;
            color: #b91c1c;
        }

        .filter-bar {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
            align-items: center;
            margin-bottom: 20px;
            padding: 16px;
            background: rgba(255, 255, 255, 0.8);
            border-radius: 14px;
            border: 1px solid var(--border-color);
        }

        .filter-input {
            flex: 1;
            min-width: 220px;
            padding: 9px 14px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 13.5px;
            font-family: inherit;
        }
        .filter-select {
            padding: 9px 14px;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            font-size: 13.5px;
            font-family: inherit;
            background: #ffffff;
            color: var(--dark-gray);
        }

        .btn-action-sm {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s ease;
        }
        .btn-action-primary {
            background: var(--primary-blue);
            color: white;
        }
        .btn-action-primary:hover {
            background: var(--royal-blue);
        }
        .btn-action-danger {
            background: #fee2e2;
            color: #b91c1c;
        }
        .btn-action-danger:hover {
            background: #ef4444;
            color: white;
        }

        /* Priority Score P(i) Pills */
        .priority-score-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 9999px;
            font-size: 11.5px;
            font-weight: 700;
            white-space: nowrap;
        }
        .pill-p-critical {
            background: #fee2e2;
            color: #b91c1c;
            border: 1px solid #fca5a5;
        }
        .pill-p-high {
            background: #ffedd5;
            color: #c2410c;
            border: 1px solid #fed7aa;
        }
        .pill-p-med {
            background: #fef3c7;
            color: #b45309;
            border: 1px solid #fde68a;
        }
        .pill-p-low {
            background: #d1fae5;
            color: #047857;
            border: 1px solid #a7f3d0;
        }

        /* Modal */
        .admin-modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(6px);
            z-index: 10000;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .admin-modal-backdrop.open {
            display: flex;
        }
        .admin-modal-box {
            background: #ffffff;
            border-radius: 20px;
            width: 100%;
            max-width: 680px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 60px rgba(15, 23, 42, 0.25);
            animation: modalPop 0.25s var(--ease-out-expo) forwards;
        }
        @keyframes modalPop {
            from { transform: scale(0.94); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        .modal-header {
            padding: 20px 24px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .modal-body {
            padding: 24px;
        }
        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            background: #f8fafc;
            border-bottom-left-radius: 20px;
            border-bottom-right-radius: 20px;
        }
    </style>
</head>
<body>

    <!-- Ambient Aurora Glow Spheres (identical to Citizen Portal) -->
    <div class="ambient-background" aria-hidden="true">
        <div class="aurora-orb aurora-orb-1" style="background: radial-gradient(circle, #fde68a 0%, rgba(253, 230, 138, 0) 70%);"></div>
        <div class="aurora-orb aurora-orb-2" style="background: radial-gradient(circle, #bfdbfe 0%, rgba(191, 219, 254, 0) 70%);"></div>
        <div class="aurora-orb aurora-orb-3" style="background: radial-gradient(circle, #bbf7d0 0%, rgba(187, 247, 208, 0) 70%);"></div>
        <div class="aurora-orb aurora-orb-4"></div>
    </div>

    <!-- Top Navigation Bar (Identical structure to Citizen Portal) -->
    <header class="top-bar">
        <div class="top-bar-left">
            <div class="logo">
                <a href="/">
                    <div class="logo-icon-wrap" style="background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 4px 12px rgba(245, 158, 11, 0.35);">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <span>Admin Portal</span>
                </a>
            </div>
            <span class="admin-badge-gold"><i class="fas fa-crown"></i> Indore Municipal Authority</span>
        </div>

        <nav class="top-bar-nav">
            <a href="/" class="top-nav-link"><i class="fas fa-home"></i> Home</a>
            <a href="/services" class="top-nav-link"><i class="fas fa-concierge-bell"></i> Services</a>
            <a href="/about" class="top-nav-link"><i class="fas fa-info-circle"></i> About</a>
            <a href="/contact" class="top-nav-link"><i class="fas fa-envelope"></i> Contact</a>
        </nav>

        <div class="top-bar-right">
            <!-- Cross Portal Switcher -->
            <div style="display: flex; gap: 8px; margin-right: 8px;">
                <a href="/user/login" class="portal-switcher-pill" title="Open Citizen Portal">
                    <i class="fas fa-user"></i> Citizen
                </a>
                <a href="/official/login" class="portal-switcher-pill" title="Open Staff/Official Portal">
                    <i class="fas fa-hard-hat"></i> Official
                </a>
            </div>

            <div class="profile-menu" style="display: flex; align-items: center; gap: 8px;">
                <div class="profile-avatar" style="width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #f59e0b, #b45309); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 15px; box-shadow: 0 4px 10px rgba(245, 158, 11, 0.35);">
                    A
                </div>
                <div style="display: flex; flex-direction: column;">
                    <span style="font-weight: 700; font-size: 13.5px; color: #ffffff;">Admin Master</span>
                    <span style="font-size: 11px; color: rgba(255, 255, 255, 0.75);">Superuser</span>
                </div>
            </div>

            <a href="/admin/logout" class="top-nav-logout-btn" title="Sign out of Admin Portal" onclick="return confirm('Sign out from Administrative Session?');">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </header>

    <!-- Main Container Layout (Matching Citizen Portal Left Rail + Main Content) -->
    <div class="main-container">
        <!-- Left Sidebar Navigation Rail -->
        <aside class="left-rail">
            <div class="quick-actions">
                <h3>Admin Control</h3>
                <div class="action-buttons">
                    <button class="action-btn active" id="btnTabOverview" onclick="switchTab('overview')">
                        <div class="btn-icon-capsule" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8);">
                            <i class="fas fa-chart-pie"></i>
                        </div>
                        <span>Overview</span>
                    </button>

                    <button class="action-btn" id="btnTabComplaints" onclick="switchTab('complaints')">
                        <div class="btn-icon-capsule action-icon-alert">
                            <i class="fas fa-list-check"></i>
                        </div>
                        <span>Complaints</span>
                    </button>

                    <button class="action-btn" id="btnTabOfficials" onclick="switchTab('officials')">
                        <div class="btn-icon-capsule" style="background: linear-gradient(135deg, #06b6d4, #0284c7);">
                            <i class="fas fa-user-tie"></i>
                        </div>
                        <span>Officials</span>
                    </button>

                    <button class="action-btn" id="btnTabRegister" onclick="switchTab('register')">
                        <div class="btn-icon-capsule" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
                            <i class="fas fa-user-plus"></i>
                        </div>
                        <span>Register Official</span>
                    </button>

                    <button class="action-btn" id="btnTabWorkers" onclick="switchTab('workers')">
                        <div class="btn-icon-capsule action-icon-track">
                            <i class="fas fa-people-carry-box"></i>
                        </div>
                        <span>Field Workers</span>
                    </button>

                    <button class="action-btn" id="btnTabCitizens" onclick="switchTab('citizens')">
                        <div class="btn-icon-capsule" style="background: linear-gradient(135deg, #8b5cf6, #6d28d9);">
                            <i class="fas fa-users"></i>
                        </div>
                        <span>Citizens</span>
                    </button>

                    <button class="action-btn" id="btnTabDepartments" onclick="switchTab('departments')">
                        <div class="btn-icon-capsule action-icon-cert">
                            <i class="fas fa-building-columns"></i>
                        </div>
                        <span>Departments</span>
                    </button>

                    <button class="action-btn" id="btnTabAppointments" onclick="switchTab('appointments')">
                        <div class="btn-icon-capsule" style="background: linear-gradient(135deg, #10b981, #059669);">
                            <i class="fas fa-calendar-check"></i>
                        </div>
                        <span>Appointments</span>
                    </button>

                    <button class="action-btn" id="btnTabEquity" onclick="switchTab('equity')">
                        <div class="btn-icon-capsule" style="background: linear-gradient(135deg, #f093fb, #f5576c);">
                            <i class="fas fa-balance-scale"></i>
                        </div>
                        <span>Equity Analytics</span>
                    </button>
                </div>
            </div>

            <!-- Quick Municipal Hotline Card -->
            <div class="admin-card" style="margin-top: 20px; padding: 16px; background: rgba(255, 255, 255, 0.65);">
                <div style="font-weight: 700; font-size: 13px; color: var(--dark-gray); margin-bottom: 6px;">
                    <i class="fas fa-server" style="color: var(--primary-blue); margin-right: 6px;"></i>System Status
                </div>
                <div style="font-size: 12px; color: var(--gray); line-height: 1.5;">
                    <div>Database: <span style="color: #10b981; font-weight: 600;">Connected</span></div>
                    <div>Port: <span style="font-weight: 600;">3000</span></div>
                    <div>Session: <span style="color: #f59e0b; font-weight: 600;">Super Administrator</span></div>
                </div>
            </div>
        </aside>

        <!-- Center Main Content -->
        <main class="main-content center-content">

            <!-- 1. TAB: OVERVIEW & ANALYTICS -->
            <section class="tab-panel active" id="panelOverview">
                <div class="admin-card" style="margin-bottom: 24px; background: linear-gradient(135deg, rgba(37, 99, 235, 0.08) 0%, rgba(245, 158, 11, 0.08) 100%);">
                    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                        <div>
                            <h1 style="font-family: 'Outfit', sans-serif; font-size: 26px; font-weight: 800; color: var(--dark-gray);">
                                Central Administrative Dashboard
                            </h1>
                            <p style="color: var(--gray); font-size: 14.5px; margin-top: 4px;">
                                Citywide civic operations, real-time grievance redressal metrics & department oversight.
                            </p>
                        </div>
                        <button class="btn-action-sm btn-action-primary" style="padding: 10px 18px; font-size: 13px;" onclick="refreshAllData()">
                            <i class="fas fa-arrows-rotate"></i> Refresh Analytics
                        </button>
                    </div>
                </div>

                <!-- KPI Metric Summary Cards -->
                <div class="stats-grid-compact">
                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">Total Complaints</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #eff6ff; display: flex; align-items: center; justify-content: center; color: var(--primary-blue);">
                                <i class="fas fa-file-invoice"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statTotalComplaints"><%= stats.total_complaints %></div>
                        <div class="kpi-sub"><i class="fas fa-city"></i> Across all municipal wards</div>
                    </div>

                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">Reported (Pending)</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #dbeafe; display: flex; align-items: center; justify-content: center; color: #1d4ed8;">
                                <i class="fas fa-clock"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statReported" style="color: #1d4ed8;"><%= stats.reported_complaints %></div>
                        <div class="kpi-sub"><i class="fas fa-bell"></i> Awaiting initial review</div>
                    </div>

                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">In Progress</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #fef3c7; display: flex; align-items: center; justify-content: center; color: #b45309;">
                                <i class="fas fa-person-digging"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statInProgress" style="color: #b45309;"><%= stats.in_progress_complaints %></div>
                        <div class="kpi-sub"><i class="fas fa-hammer"></i> Field teams assigned</div>
                    </div>

                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">Resolved</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #d1fae5; display: flex; align-items: center; justify-content: center; color: #047857;">
                                <i class="fas fa-check-circle"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statResolved" style="color: #047857;"><%= stats.resolved_complaints %></div>
                        <div class="kpi-sub"><i class="fas fa-circle-check"></i> Redressed successfully</div>
                    </div>

                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">Rejected</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #fee2e2; display: flex; align-items: center; justify-content: center; color: #b91c1c;">
                                <i class="fas fa-ban"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statRejected" style="color: #b91c1c;"><%= stats.rejected_complaints %></div>
                        <div class="kpi-sub"><i class="fas fa-circle-xmark"></i> Spam / duplicate / invalid</div>
                    </div>

                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">Registered Citizens</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #ede9fe; display: flex; align-items: center; justify-content: center; color: #6d28d9;">
                                <i class="fas fa-users"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statCitizens"><%= stats.total_citizens %></div>
                        <div class="kpi-sub"><i class="fas fa-address-card"></i> Active portal users</div>
                    </div>

                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">Municipal Officials</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #cffafe; display: flex; align-items: center; justify-content: center; color: #0284c7;">
                                <i class="fas fa-user-tie"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statOfficials"><%= stats.total_officials %></div>
                        <div class="kpi-sub"><i class="fas fa-briefcase"></i> Authorized officers</div>
                    </div>

                    <div class="admin-card">
                        <div style="display: flex; justify-content: space-between; align-items: center;">
                            <span style="font-size: 13px; font-weight: 700; color: var(--gray); text-transform: uppercase;">Field Workers</span>
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: #ffedd5; display: flex; align-items: center; justify-content: center; color: #c2410c;">
                                <i class="fas fa-helmet-safety"></i>
                            </div>
                        </div>
                        <div class="kpi-num" id="statWorkers"><%= stats.total_workers %></div>
                        <div class="kpi-sub"><i class="fas fa-wrench"></i> Field workforce</div>
                    </div>
                </div>

                <!-- Department Breakdown & Recent Activity -->
