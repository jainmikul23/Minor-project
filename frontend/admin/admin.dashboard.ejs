                <!-- Resolution Verification & Field Worker -->
                <div style="background: #f1f5f9; border-radius: 12px; padding: 12px 16px; margin-bottom: 16px; border: 1px solid #e2e8f0;">
                    <div style="font-size: 11px; font-weight: 800; color: #334155; text-transform: uppercase; margin-bottom: 8px;">
                        <i class="fas fa-hard-hat" style="color: #10b981;"></i> Field Operations & OTP Verification (Section V-E)
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; font-size: 12.5px;">
                        <div>
                            <span style="color: #64748b; font-size: 11px; display: block;">Assigned Worker:</span>
                            <strong>${workerFull}</strong>
                        </div>
                        <div>
                            <span style="color: #64748b; font-size: 11px; display: block;">Resident OTP Status:</span>
                            ${complaint.otp_verified_at 
                                ? `<strong style="color: #047857;"><i class="fas fa-check-double"></i> Verified (${escapeHtml(complaint.resolution_otp || '')})</strong>`
                                : complaint.resolution_otp 
                                    ? `<strong style="color: #b45309;"><i class="fas fa-key"></i> Code: ${escapeHtml(complaint.resolution_otp)} (Pending)</strong>`
                                    : '<span style="color: #94a3b8;">Pending GPS Proof</span>'
                            }
                        </div>
                    </div>
                    ${proofPhotoHtml}
                </div>

                <div style="margin-bottom: 16px;">
                    <div style="font-size: 11px; text-transform: uppercase; color: var(--gray); font-weight: 700; margin-bottom: 4px;">Grievance Description</div>
                    <div style="padding: 12px; background: #f8fafc; border-radius: 8px; border: 1px solid var(--border-color); font-size: 13.5px; color: var(--dark-gray); line-height: 1.5;">
                        ${escapeHtml(complaint.description || 'No description provided')}
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 700; color: var(--dark-gray); margin-bottom: 6px;">Status Action</label>
                        <select id="modalStatusSelect" class="filter-select" style="width: 100%;" onchange="toggleRejectionBox()">
                            <option value="reported" ${complaint.status === 'reported' ? 'selected' : ''}>Reported (Pending)</option>
                            <option value="in-progress" ${complaint.status === 'in-progress' ? 'selected' : ''}>In Progress</option>
                            <option value="resolved" ${complaint.status === 'resolved' ? 'selected' : ''}>Resolved</option>
                            <option value="rejected" ${complaint.status === 'rejected' ? 'selected' : ''}>Rejected</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 700; color: var(--dark-gray); margin-bottom: 6px;">Transfer Department</label>
                        <select id="modalDeptSelect" class="filter-select" style="width: 100%;">
                            ${allDepartments.map(d => `
                                <option value="${d.department_id}" ${complaint.department_id === d.department_id ? 'selected' : ''}>${escapeHtml(d.Name)}</option>
                            `).join('')}
                        </select>
                    </div>
                </div>

                <div id="modalRejectionGroup" style="display: ${complaint.status === 'rejected' ? 'block' : 'none'}; margin-bottom: 14px;">
                    <label style="display: block; font-size: 12px; font-weight: 700; color: #b91c1c; margin-bottom: 6px;">Rejection Reason</label>
                    <textarea id="modalRejectionReason" class="filter-input" style="width: 100%; min-height: 70px;" placeholder="Provide specific reason for rejection...">${escapeHtml(complaint.rejection_reason || '')}</textarea>
                </div>
            `;

            document.getElementById('complaintModal').classList.add('open');
        }

        function toggleRejectionBox() {
            const status = document.getElementById('modalStatusSelect').value;
            const group = document.getElementById('modalRejectionGroup');
            if (group) group.style.display = (status === 'rejected') ? 'block' : 'none';
        }

        function closeComplaintModal() {
            document.getElementById('complaintModal').classList.remove('open');
            currentModalComplaintId = null;
        }

        async function saveComplaintChanges() {
            if (!currentModalComplaintId) return;

            const status = document.getElementById('modalStatusSelect').value;
            const department_id = document.getElementById('modalDeptSelect').value;
            const rejection_reason = document.getElementById('modalRejectionReason')?.value || '';

            const saveBtn = document.getElementById('modalSaveBtn');
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving...';

            try {
                const res = await fetch(`/admin/api/complaints/${currentModalComplaintId}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ status, department_id, rejection_reason })
                });
                const result = await res.json();
                if (res.ok) {
                    showToast('Complaint updated successfully!');
                    closeComplaintModal();
                    loadComplaints();
                    loadOverviewStats();
                } else {
                    alert('Error: ' + (result.error || 'Failed to update'));
                }
            } catch (err) {
                console.error('Error saving complaint:', err);
                alert('An error occurred while updating the complaint.');
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="fas fa-save"></i> Save Changes';
            }
        }

        async function deleteComplaintCurrent() {
            if (!currentModalComplaintId) return;
            if (!confirm(`Are you sure you want to permanently delete Complaint #${currentModalComplaintId}?`)) return;

            try {
                const res = await fetch(`/admin/api/complaints/${currentModalComplaintId}`, {
                    method: 'DELETE',
                    credentials: 'include'
                });
                const result = await res.json();
                if (res.ok) {
                    showToast('Complaint removed successfully');
                    closeComplaintModal();
                    loadComplaints();
                    loadOverviewStats();
                } else {
                    alert('Error: ' + (result.error || 'Failed to delete'));
                }
            } catch (err) {
                console.error('Error deleting complaint:', err);
            }
        }

        // 5. Officials Loader
        async function loadOfficials() {
            const tbody = document.getElementById('officialsTableBody');
            tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 24px; color: #94a3b8;"><i class="fas fa-spinner fa-spin"></i> Loading officials...</td></tr>';

            try {
                const res = await fetch('/admin/api/officials');
                if (res.ok) {
                    const data = await res.json();
                    const officials = data.officials || [];

                    if (officials.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 32px; color: #94a3b8;">No officials found. Register one above!</td></tr>';
                        return;
                    }

                    tbody.innerHTML = officials.map(o => `
                        <tr>
                            <td style="font-weight: 700;">#${o.official_id}</td>
                            <td style="font-weight: 600;">${escapeHtml(o.First_name)} ${escapeHtml(o.Last_name)}</td>
                            <td><code>${escapeHtml(o.Login_credentials)}</code></td>
                            <td><span style="font-weight: 600; color: var(--primary-blue);">${escapeHtml(o.department_name || 'General')}</span></td>
                            <td>${escapeHtml(o.Email)}</td>
                            <td>${escapeHtml(o.Phone)}</td>
                            <td><span style="font-weight: 700; color: #0284c7;">${o.total_assignments || 0}</span> tasks (${o.active_assignments || 0} active)</td>
                            <td>
                                <button class="btn-action-sm btn-action-danger" onclick="deleteOfficial(${o.official_id}, '${escapeHtml(o.First_name)} ${escapeHtml(o.Last_name)}')">
                                    <i class="fas fa-trash"></i> Remove
                                </button>
                            </td>
                        </tr>
                    `).join('');
                }
            } catch (err) {
                console.error('Error loading officials:', err);
            }
        }

        async function deleteOfficial(id, name) {
            if (!confirm(`Are you sure you want to remove official ${name}?`)) return;
            try {
                const res = await fetch(`/admin/api/officials/${id}`, { method: 'DELETE', credentials: 'include' });
                if (res.ok) {
                    showToast(`Official ${name} removed`);
                    loadOfficials();
                    loadOverviewStats();
                } else {
                    const d = await res.json();
                    alert(d.error || 'Failed to delete official');
                }
            } catch (e) {
                console.error('Error removing official:', e);
            }
        }

        // Inline Official Registration
        async function submitInlineOfficial() {
            const firstName = document.getElementById('regFirstName').value.trim();
            const lastName = document.getElementById('regLastName').value.trim();
            const email = document.getElementById('regEmail').value.trim();
            const phone = document.getElementById('regPhone').value.trim();
            const loginCredentials = document.getElementById('regLoginCreds').value.trim();
            const departmentId = document.getElementById('regDeptSelect').value;
            const password = document.getElementById('regPassword').value.trim();

            if (password.length < 6) {
                alert('Password must be at least 6 characters.');
                return;
            }

            const btn = document.getElementById('btnSubmitInlineOfficial');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Provisioning Official...';

            try {
                const res = await fetch('/admin/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        First_name: firstName,
                        Last_name: lastName,
                        Email: email,
                        Phone: phone,
                        Login_credentials: loginCredentials,
                        department_id: departmentId,
                        Password: password
                    })
                });
                const result = await res.json();
                if (res.ok) {
                    showToast(`Official ${firstName} registered successfully!`);
                    document.getElementById('inlineRegisterForm').reset();
                    switchTab('officials');
                    loadOverviewStats();
                } else {
                    alert('Registration failed: ' + (result.error || 'Unknown error'));
                }
            } catch (e) {
                console.error('Error registering official:', e);
                alert('An error occurred during registration.');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check-circle"></i> Provision & Create Official Account';
            }
        }

        // 6. Field Workers Loader
        async function loadWorkers() {
            const tbody = document.getElementById('workersTableBody');
            tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 24px; color: #94a3b8;"><i class="fas fa-spinner fa-spin"></i> Loading field workers...</td></tr>';

            try {
                const res = await fetch('/admin/api/workers');
                if (res.ok) {
                    const data = await res.json();
                    const workers = data.workers || [];

                    if (workers.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="8" style="text-align: center; padding: 32px; color: #94a3b8;">No field workers found. Add one above!</td></tr>';
                        return;
                    }

                    tbody.innerHTML = workers.map(w => {
                        const isBusy = (w.status === 'busy');
                        const statusPill = isBusy
                            ? '<span class="status-pill status-pill-in-progress"><i class="fas fa-hammer"></i> Active Task</span>'
                            : '<span class="status-pill status-pill-resolved"><i class="fas fa-check"></i> Available</span>';

                        const skills = [w.Skill_1, w.Skill_2, w.Skill_3, w.Skill_4].filter(Boolean).join(', ');

                        return `
                            <tr>
                                <td style="font-weight: 700;">#${w.worker_id}</td>
                                <td style="font-weight: 600;">${escapeHtml(w.First_name)} ${escapeHtml(w.Last_name)}</td>
                                <td><span style="font-weight: 600; color: var(--primary-blue);">${escapeHtml(w.department_name || 'General')}</span></td>
                                <td>${escapeHtml(w.Phone)}</td>
                                <td style="font-size: 12.5px;">${escapeHtml(skills || 'General Maintenance')}</td>
                                <td>${statusPill}</td>
                                <td>${w.active_complaint_id ? `<span style="font-weight: 600;">Complaint #${w.active_complaint_id}</span>` : '<span style="color:#94a3b8;">None</span>'}</td>
                                <td>
                                    <button class="btn-action-sm btn-action-danger" onclick="deleteWorker(${w.worker_id}, '${escapeHtml(w.First_name)}')">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error('Error loading workers:', err);
            }
        }

        function openAddWorkerModal() {
            document.getElementById('workerModal').classList.add('open');
        }
        function closeAddWorkerModal() {
            document.getElementById('workerModal').classList.remove('open');
        }

        async function submitAddWorker() {
            const firstName = document.getElementById('newWorkerFirstName').value.trim();
            const lastName = document.getElementById('newWorkerLastName').value.trim();
            const phone = document.getElementById('newWorkerPhone').value.trim();
            const department_id = document.getElementById('newWorkerDept').value;
            const skill1 = document.getElementById('newWorkerSkill1').value.trim();
            const skill2 = document.getElementById('newWorkerSkill2').value.trim();

            try {
                const res = await fetch('/admin/api/workers', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({
                        First_name: firstName,
                        Last_name: lastName,
                        Phone: phone,
                        department_id: department_id,
                        Skill_1: skill1,
                        Skill_2: skill2
                    })
                });
                const result = await res.json();
                if (res.ok) {
                    showToast('Worker added successfully!');
                    closeAddWorkerModal();
                    loadWorkers();
                    loadOverviewStats();
                } else {
                    alert('Error: ' + (result.error || 'Failed to add worker'));
                }
            } catch (e) {
                console.error('Error adding worker:', e);
            }
        }

        async function deleteWorker(id, name) {
            if (!confirm(`Are you sure you want to remove worker ${name}?`)) return;
            try {
                const res = await fetch(`/admin/api/workers/${id}`, { method: 'DELETE', credentials: 'include' });
                if (res.ok) {
                    showToast(`Worker ${name} removed`);
                    loadWorkers();
                    loadOverviewStats();
                }
            } catch (e) {
                console.error('Error removing worker:', e);
            }
        }

        // 7. Citizens Loader
        async function loadCitizens() {
            const tbody = document.getElementById('citizensTableBody');
            tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; padding: 24px; color: #94a3b8;"><i class="fas fa-spinner fa-spin"></i> Loading citizens...</td></tr>';

            try {
                const res = await fetch('/admin/api/citizens');
                if (res.ok) {
                    const data = await res.json();
                    const citizens = data.citizens || [];
                    document.getElementById('citizensCountBadge').textContent = `${citizens.length} Citizens Registered`;

                    if (citizens.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="9" style="text-align: center; padding: 32px; color: #94a3b8;">No citizens registered yet.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = citizens.map(c => {
                        const dateStr = c.created_at ? new Date(c.created_at).toLocaleDateString('en-IN') : 'N/A';
                        return `
                            <tr>
                                <td style="font-weight: 700;">#${c.user_id}</td>
                                <td style="font-weight: 600;">${escapeHtml(c.First_name)} ${escapeHtml(c.Last_name)}</td>
                                <td>${escapeHtml(c.Email)}</td>
                                <td>${escapeHtml(c.Phone)}</td>
                                <td>${escapeHtml(c.City || 'Indore')}, ${escapeHtml(c.State || 'MP')}</td>
                                <td><code>${escapeHtml(c.Pincode || '')}</code></td>
                                <td><span style="font-weight: 700; color: var(--primary-blue);">${c.total_complaints || 0}</span></td>
                                <td><span style="font-weight: 700; color: #047857;">${c.resolved_complaints || 0}</span></td>
                                <td style="font-size: 12px; color: var(--gray);">${dateStr}</td>
                            </tr>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error('Error loading citizens:', err);
            }
        }

        // 8. Departments & Categories Loader
        async function loadDepartments() {
            const grid = document.getElementById('departmentsGrid');
            try {
                const res = await fetch('/admin/api/departments');
                if (res.ok) {
                    const data = await res.json();
                    const depts = data.departments || [];

                    grid.innerHTML = depts.map(d => {
                        const cats = (d.categories || []).map(cat => `
                            <span style="display: inline-block; padding: 3px 8px; border-radius: 6px; background: #f1f5f9; font-size: 12px; color: var(--dark-gray); margin-right: 4px; margin-bottom: 4px;">
                                ${escapeHtml(cat.Name)}
                            </span>
                        `).join('') || '<span style="color:#94a3b8; font-size: 12px;">No sub-categories</span>';

                        return `
                            <div class="admin-card">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px;">
                                    <div>
                                        <span style="font-size: 11px; font-weight: 700; color: var(--gray); text-transform: uppercase;">ID: #${d.department_id}</span>
                                        <h3 style="font-size: 17px; font-weight: 700; color: var(--primary-blue); margin-top: 2px;">${escapeHtml(d.Name)}</h3>
                                    </div>
                                    <div style="width: 36px; height: 36px; border-radius: 10px; background: #eff6ff; display: flex; align-items: center; justify-content: center; color: var(--primary-blue);">
                                        <i class="fas fa-building"></i>
                                    </div>
                                </div>
                                <div style="font-size: 12.5px; color: var(--gray); margin-bottom: 12px; line-height: 1.4;">
                                    <i class="fas fa-phone-alt" style="margin-right: 6px; color: #10b981;"></i>${escapeHtml(d.Contact_info || 'Municipal Helpdesk')}
                                </div>
                                <div style="font-size: 12px; font-weight: 700; color: var(--dark-gray); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Grievance Categories</div>
                                <div>${cats}</div>
                            </div>
                        `;
                    }).join('');
                }
            } catch (err) {
                console.error('Error loading departments:', err);
            }
        }

        // 9. Citywide Appointments Loader for Admin
        async function loadAdminAppointments() {
            const tbody = document.getElementById('adminAppointmentsBody');
            try {
                const res = await fetch('/admin/api/appointments');
                if (res.ok) {
                    const data = await res.json();
                    const appointments = data.appointments || [];

                    // Update KPIs
                    const total = appointments.length;
                    const confirmed = appointments.filter(a => a.status === 'confirmed').length;
                    const completed = appointments.filter(a => a.status === 'completed').length;
                    const cancelled = appointments.filter(a => a.status === 'cancelled').length;

                    document.getElementById('aptTotalKpi').textContent = total;
                    document.getElementById('aptConfirmedKpi').textContent = confirmed;
                    document.getElementById('aptCompletedKpi').textContent = completed;
                    document.getElementById('aptCancelledKpi').textContent = cancelled;

                    if (appointments.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #94a3b8; padding: 32px;">No citizen appointments booked yet.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = appointments.map(a => {
                        const dateStr = new Date(a.appointment_date).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
                        const isCompleted = a.status === 'completed';
                        const isCancelled = a.status === 'cancelled';
                        const statusColor = isCompleted ? '#047857' : isCancelled ? '#b91c1c' : '#1d4ed8';
                        const statusBg = isCompleted ? '#dcfce7' : isCancelled ? '#fee2e2' : '#dbeafe';

                        return `
                            <tr>
                                <td>
                                    <span style="font-family: monospace; font-weight: 700; background: #f1f5f9; padding: 2px 8px; border-radius: 6px; border: 1px solid #cbd5e1; color: var(--primary-blue); font-size: 12px;">
                                        ${escapeHtml(a.token_number)}
                                    </span>
                                </td>
                                <td>
                                    <div style="font-weight: 700; color: var(--dark-gray); font-size: 13.5px;">
                                        ${escapeHtml(a.First_name)} ${escapeHtml(a.Last_name)}
                                    </div>
                                    <div style="font-size: 12px; color: var(--gray); margin-top: 2px;">
                                        <i class="fas fa-phone-alt" style="margin-right: 4px;"></i>${escapeHtml(a.Phone || 'N/A')}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background: #eff6ff; color: #1e40af; border: 1px solid #bfdbfe; font-size: 12px;">
                                        <i class="fas fa-building" style="margin-right: 4px;"></i>${escapeHtml(a.department_name)}
                                    </span>
                                </td>
                                <td>
                                    <div style="font-weight: 600; font-size: 13px; color: var(--dark-gray);">${dateStr}</div>
                                    <div style="font-size: 11.5px; color: var(--gray);"><i class="fas fa-clock" style="margin-right: 4px;"></i>${escapeHtml(a.time_slot)}</div>
                                </td>
                                <td>
                                    <div style="max-width: 240px; font-size: 12.5px; color: #334155; line-height: 1.4;">
                                        ${escapeHtml(a.purpose || 'General Consultation')}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge" style="background: ${statusBg}; color: ${statusColor}; font-weight: 700; text-transform: uppercase; font-size: 11px;">
                                        ${escapeHtml(a.status)}
                                    </span>
                                </td>
                                <td>
                                    ${!isCompleted && !isCancelled ? `
                                        <div style="display: flex; gap: 6px;">
                                            <button class="btn-action-sm btn-action-success" onclick="updateAdminAppointmentStatus(${a.appointment_id}, 'completed')" title="Mark Consultation Completed">
                                                <i class="fas fa-check"></i>
                                            </button>
                                            <button class="btn-action-sm btn-action-danger" onclick="updateAdminAppointmentStatus(${a.appointment_id}, 'cancelled')" title="Cancel Appointment">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    ` : `
                                        <span style="font-size: 12px; color: var(--gray);">No action</span>
                                    `}
                                </td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #ef4444; padding: 24px;">Failed to fetch appointments.</td></tr>';
                }
            } catch (err) {
                console.error('Error loading admin appointments:', err);
                tbody.innerHTML = '<tr><td colspan="7" style="text-align: center; color: #ef4444; padding: 24px;">Error loading appointments.</td></tr>';
            }
        }

        async function updateAdminAppointmentStatus(id, status) {
            try {
                const res = await fetch(`/admin/api/appointments/${id}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                if (res.ok) {
                    showToast(`Appointment status updated to ${status}`);
                    loadAdminAppointments();
                } else {
                    alert('Failed to update status');
                }
            } catch (e) {
                console.error(e);
                alert('Network error updating status');
            }
        }

        // Utility: Toast notification
        function showToast(message) {
            const toast = document.createElement('div');
            toast.style.cssText = `
                position: fixed;
                bottom: 24px;
                right: 24px;
                background: linear-gradient(135deg, #1e293b, #0f172a);
                color: #ffffff;
                padding: 12px 22px;
                border-radius: 12px;
                font-weight: 600;
                font-size: 13.5px;
                box-shadow: 0 10px 25px rgba(0,0,0,0.25);
                z-index: 99999;
                display: flex;
                align-items: center;
                gap: 10px;
                transform: translateY(20px);
                opacity: 0;
                transition: all 0.3s ease;
            `;
            toast.innerHTML = `<i class="fas fa-check-circle" style="color: #10b981;"></i><span>${escapeHtml(message)}</span>`;
            document.body.appendChild(toast);
            setTimeout(() => {
                toast.style.transform = 'translateY(0)';
                toast.style.opacity = '1';
            }, 50);
            setTimeout(() => {
                toast.style.transform = 'translateY(20px)';
                toast.style.opacity = '0';
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        // Safe HTML escape helper
        function escapeHtml(text) {
            if (!text) return '';
            return String(text)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // ═══ EQUITY ANALYTICS ═══
        async function loadEquityAnalytics() {
            try {
                const tbody = document.getElementById('equityTableBody');
                const alertsDiv = document.getElementById('silentWardAlerts');
                if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;"><i class="fas fa-spinner fa-spin"></i> Loading ward analytics...</td></tr>';

                const res = await fetch('/admin/api/equity-analytics', { credentials: 'include' });
                if (!res.ok) throw new Error('Failed to fetch equity analytics');
                const data = await res.json();

                const wards = data.wards || [];
                const silentWards = wards.filter(w => w.z_score < -1.0);
                const avgRI = wards.length ? (wards.reduce((s, w) => s + (w.reporting_intensity || 0), 0) / wards.length).toFixed(2) : '0';
                const maxRI = wards.length ? Math.max(...wards.map(w => w.reporting_intensity || 0)).toFixed(2) : '0';

                // Update KPIs
                const setEl = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val; };
                setEl('eq-totalWards', wards.length);
                setEl('eq-silentWards', silentWards.length);
                setEl('eq-avgRI', avgRI);
                setEl('eq-maxRI', maxRI);

                // Silent ward alerts
                if (alertsDiv) {
                    if (silentWards.length === 0) {
                        alertsDiv.innerHTML = '<div style="background:rgba(16,185,129,0.1);border:1px solid rgba(16,185,129,0.3);border-radius:12px;padding:1rem;color:#10b981;"><i class="fas fa-check-circle"></i> No silent wards detected. All wards have adequate reporting activity.</div>';
                    } else {
                        const alertHTML = silentWards.map(w => `
                            <div style="background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:10px;padding:0.8rem 1rem;margin-bottom:0.5rem;display:flex;align-items:center;gap:1rem;">
                                <i class="fas fa-exclamation-triangle" style="color:#ef4444;font-size:1.2rem;"></i>
                                <div>
                                    <strong>Ward ${w.ward_no} \u2014 Silent Ward Alert</strong><br>
                                    <span style="font-size:0.82rem;color:var(--gray);">RI = ${(w.reporting_intensity||0).toFixed(2)} | Z-score = ${(w.z_score||0).toFixed(2)} | ${w.total_complaints || 0} complaints total</span>
                                </div>
                                <span class="status-pill status-pill-reported" style="margin-left:auto;">Proactive Inspection Needed</span>
                            </div>`).join('');
                        alertsDiv.innerHTML = `<div style="margin-bottom:0.5rem;font-weight:600;color:#ef4444;"><i class="fas fa-bell"></i> ${silentWards.length} Silent Ward(s) Detected</div>${alertHTML}`;
                    }
                }

                // Build table
                if (tbody) {
                    if (wards.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--gray);">No ward data available. Add ward_no to complaints.</td></tr>';
                    } else {
                        tbody.innerHTML = wards.sort((a, b) => (a.z_score || 0) - (b.z_score || 0)).map(w => {
                            const z = (w.z_score || 0).toFixed(2);
                            const ri = (w.reporting_intensity || 0).toFixed(2);
                            const isSilent = w.z_score < -1.0;
                            const isHot = w.z_score > 1.5;
                            const pillClass = isSilent ? 'status-pill-reported' : isHot ? 'status-pill-resolved' : 'status-pill-in-progress';
                            const statusText = isSilent ? '\uD83D\uDD34 Silent Ward' : isHot ? '\uD83D\uDFE2 High Activity' : '\uD83D\uDFE1 Normal';
                            return `<tr>
                                <td><strong>Ward ${w.ward_no}</strong></td>
                                <td>${w.total_complaints || 0}</td>
                                <td>${ri}</td>
                                <td><strong style="color:${isSilent?'#ef4444':isHot?'#10b981':'var(--dark-gray)'}">${z}</strong></td>
                                <td><span class="status-pill ${pillClass}">${statusText}</span></td>
                                <td><button class="btn-action-sm btn-action-primary" onclick="alert('Dispatch inspection team to Ward ${w.ward_no}')"><i class="fas fa-hard-hat"></i> Dispatch</button></td>
                            </tr>`;
                        }).join('');
                    }
                }
            } catch (err) {
                console.error('Equity analytics error:', err);
                const tbody = document.getElementById('equityTableBody');
                if (tbody) tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:#ef4444;"><i class="fas fa-exclamation-circle"></i> Failed to load ward analytics. Ensure /admin/api/equity-analytics is working.</td></tr>';
            }
        }
    </script>
</body>
</html>

