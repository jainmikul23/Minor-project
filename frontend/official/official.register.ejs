<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Official - Municipal Admin Portal</title>
    <link rel="stylesheet" href="/styles/common.css">
    <link rel="stylesheet" href="/css/motion-engine.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        .auth-container {
            max-width: 680px;
            width: 100%;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <!-- 3D Ambient Lighting & Perspective Grid -->
    <div class="bg-ambient-layer">
        <div class="bg-perspective-grid"></div>
        <div class="floating-orb orb-1"></div>
        <div class="floating-orb orb-2"></div>
        <div class="floating-orb orb-3"></div>
    </div>

    <!-- Top Floating Navigation -->
    <header class="top-nav-bar">
        <a href="/admin/dashboard" class="back-home-btn">
            <i class="fas fa-arrow-left"></i>
            <span>Back to Admin Dashboard</span>
        </a>
        <div class="portal-badge-pill" style="border-color: rgba(245, 158, 11, 0.4); background: rgba(245, 158, 11, 0.12);">
            <span class="pulse-dot" style="background: #f59e0b; box-shadow: 0 0 10px #f59e0b;"></span>
            <span style="color: #fbbf24;">Admin Portal Active</span>
        </div>
    </header>

    <!-- 3D Card Scene -->
    <div class="auth-card-scene" id="cardScene">
        <div class="auth-container" id="tiltCard">
            <!-- Specular reflection glare -->
            <div class="card-specular-glare" id="cardGlare"></div>

            <div class="card-content-layer">
                <!-- Header -->
                <div class="auth-header">
                    <div class="logo-badge-3d" style="background: linear-gradient(135deg, #f59e0b, #d97706); box-shadow: 0 10px 25px rgba(245, 158, 11, 0.4);">
                        <i class="fas fa-user-plus"></i>
                    </div>
                    <h1>Register Municipal Official</h1>
                    <p>Provision staff credentials for department officers and field leads</p>
                </div>

                <!-- Form -->
                <form class="auth-form" id="registerForm" onsubmit="event.preventDefault(); registerDetails();">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="First_name">First Name</label>
                            <div class="input-3d-wrapper">
                                <i class="fas fa-user input-icon-left"></i>
                                <input type="text" id="First_name" name="First_name" placeholder="e.g. Rahul" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="Last_name">Last Name</label>
                            <div class="input-3d-wrapper">
                                <i class="fas fa-user input-icon-left"></i>
                                <input type="text" id="Last_name" name="Last_name" placeholder="e.g. Verma" required>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="email">Official Email</label>
                            <div class="input-3d-wrapper">
                                <i class="fas fa-envelope input-icon-left"></i>
                                <input type="email" id="email" name="Email" placeholder="officer@indore.gov.in" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="Phone">Contact Phone</label>
                            <div class="input-3d-wrapper">
                                <i class="fas fa-phone input-icon-left"></i>
                                <input type="tel" id="Phone" name="Phone" placeholder="10-digit number" required>
                            </div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label for="Login_credentials">Login ID / Username</label>
                            <div class="input-3d-wrapper">
                                <i class="fas fa-id-badge input-icon-left"></i>
                                <input type="text" id="Login_credentials" name="Login_credentials" placeholder="e.g. WATER_OFFICER_02" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="department_id">Assigned Department</label>
                            <div class="input-3d-wrapper">
                                <i class="fas fa-building input-icon-left"></i>
                                <select id="department_id" name="department_id" required style="width: 100%; padding-left: 42px; height: 48px; border-radius: 12px; border: 1.5px solid var(--input-border); background: var(--input-bg); font-family: inherit; font-size: 14px; color: var(--text-main);">
                                    <option value="">-- Select Department --</option>
                                    <option value="1">1 - Water Supply</option>
                                    <option value="2">2 - Electricity</option>
                                    <option value="3">3 - Road Maintenance</option>
                                    <option value="4">4 - Sanitation</option>
                                    <option value="5">5 - Public Health</option>
                                    <option value="6">6 - Parks & Recreation</option>
                                    <option value="7">7 - Public Safety</option>
                                    <option value="8">8 - Roads & Transport</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="Password">Password (Min 6 Characters)</label>
                        <div class="input-3d-wrapper">
                            <i class="fas fa-lock input-icon-left"></i>
                            <input type="password" id="Password" name="Password" placeholder="Create strong temporary password" required>
                            <button type="button" class="password-toggle-btn" onclick="togglePasswordVisibility()" title="Show/Hide Password">
                                <i class="fas fa-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn-3d-primary" id="registerBtn" style="background: linear-gradient(135deg, #d97706 0%, #b45309 100%); box-shadow: 0 10px 25px rgba(217, 119, 6, 0.4);">
                        <span id="btnText"><i class="fas fa-check-circle" style="margin-right: 8px;"></i>Register Official</span>
                    </button>
                </form>

                <div class="auth-footer">
                    <a href="/admin/dashboard"><i class="fas fa-arrow-left"></i> Return to Admin Dashboard</a> | <a href="/admin/logout">Sign Out</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Environment Config -->
    <script src="/js/env.js"></script>

    <script>
        // Load live departments from backend API
        async function loadDepartments() {
            try {
                const apiBase = (typeof window.__ENV__ !== 'undefined' && window.__ENV__.API_BASE_URL)
                    ? window.__ENV__.API_BASE_URL
                    : ((window.location && window.location.hostname.indexOf('uyvr') !== -1) ? 'https://minor-project-t1cf.onrender.com' : '');
                const res = await fetch(apiBase + '/api/departments');
                if (res.ok) {
                    const data = await res.json();
                    if (data.departments && data.departments.length > 0) {
                        const select = document.getElementById('department_id');
                        select.innerHTML = '<option value="">-- Select Department --</option>';
                        data.departments.forEach(dept => {
                            const opt = document.createElement('option');
                            opt.value = dept.department_id;
                            opt.textContent = `${dept.department_id} - ${dept.Name}`;
                            select.appendChild(opt);
                        });
                    }
                }
            } catch (e) {
                console.warn('Could not load departments dynamically, using static fallback:', e);
            }
        }
        document.addEventListener('DOMContentLoaded', loadDepartments);

        // Toggle Password Visibility
        function togglePasswordVisibility() {
            const passInput = document.getElementById('Password');
            const toggleIcon = document.getElementById('toggleIcon');
            if (passInput.type === 'password') {
                passInput.type = 'text';
                toggleIcon.classList.remove('fa-eye');
                toggleIcon.classList.add('fa-eye-slash');
            } else {
                passInput.type = 'password';
                toggleIcon.classList.remove('fa-eye-slash');
                toggleIcon.classList.add('fa-eye');
            }
        }

        // 3D Parallax Tilt
        const scene = document.getElementById('cardScene');
        const card = document.getElementById('tiltCard');
        const glare = document.getElementById('cardGlare');

        scene.addEventListener('mousemove', (e) => {
            const bounds = card.getBoundingClientRect();
            const mouseX = e.clientX - bounds.left;
            const mouseY = e.clientY - bounds.top;
            const xPct = mouseX / bounds.width;
            const yPct = mouseY / bounds.height;
            const rotateX = ((0.5 - yPct) * 6).toFixed(2);
            const rotateY = ((xPct - 0.5) * 6).toFixed(2);
            card.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            card.style.setProperty('--mouse-x', `${(xPct * 100).toFixed(1)}%`);
            card.style.setProperty('--mouse-y', `${(yPct * 100).toFixed(1)}%`);
            glare.style.opacity = '1';
        });

        scene.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
            glare.style.opacity = '0';
        });

        // Register Official
        async function registerDetails() {
            const firstName = document.getElementById('First_name').value.trim();
            const lastName = document.getElementById('Last_name').value.trim();
            const email = document.getElementById('email').value.trim();
            const password = document.getElementById('Password').value.trim();
            const phone = document.getElementById('Phone').value.trim();
            const loginCredentials = document.getElementById('Login_credentials').value.trim();
            const departmentId = document.getElementById('department_id').value.trim();

            const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailPattern.test(email)) {
                alert('Please enter a valid email address.');
                return;
            }

            if (password.length < 6) {
                alert('Password must be at least 6 characters long.');
                return;
            }

            if (!departmentId) {
                alert('Please select a department.');
                return;
            }

            const data = {
                First_name: firstName,
                Last_name: lastName,
                Email: email,
                Password: password,
                Phone: phone,
                Login_credentials: loginCredentials,
                department_id: departmentId
            };

            const btn = document.getElementById('registerBtn');
            const btnText = document.getElementById('btnText');
            btn.disabled = true;
            btnText.innerHTML = '<i class="fas fa-spinner fa-spin" style="margin-right: 8px;"></i>Registering Official...';

            try {
                const apiBase = (typeof window.__ENV__ !== 'undefined' && window.__ENV__.API_BASE_URL)
                    ? window.__ENV__.API_BASE_URL
                    : ((window.location && window.location.hostname.indexOf('uyvr') !== -1) ? 'https://minor-project-t1cf.onrender.com' : '');
                const response = await fetch(apiBase + '/admin/register', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    credentials: 'include',
                    body: JSON.stringify(data)
                });
                const result = await response.json();

                if (response.ok) {
                    btnText.innerHTML = '<i class="fas fa-check" style="margin-right: 8px;"></i>Official Registered!';
                    btn.style.background = 'linear-gradient(135deg, #10b981 0%, #059669 100%)';
                    alert(`Success! Official ${firstName} ${lastName} (${loginCredentials}) was registered.`);
                    document.getElementById('registerForm').reset();
                    setTimeout(() => {
                        window.location.href = '/admin/dashboard#officials';
                    }, 800);
                } else {
                    alert('Registration failed: ' + (result.error || 'Unknown error'));
                    btn.disabled = false;
                    btnText.innerHTML = '<i class="fas fa-check-circle" style="margin-right: 8px;"></i>Register Official';
                }
            } catch (error) {
                console.error('Error registering official:', error);
                alert('An error occurred during registration. Please try again.');
                btn.disabled = false;
                btnText.innerHTML = '<i class="fas fa-check-circle" style="margin-right: 8px;"></i>Register Official';
            }
        }
    </script>
    <!-- Premium Animation & Smooth Scroll Engine -->
    <script src="/vendor/lenis.min.js"></script>
    <script src="/vendor/gsap.min.js"></script>
    <script src="/vendor/ScrollTrigger.min.js"></script>
    <script src="/vendor/anime.min.js"></script>
    <script src="/js/motion-engine.js"></script>
</body>
</html>
