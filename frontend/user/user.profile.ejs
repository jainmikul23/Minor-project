            </div>
            <div>
                <h3 style="margin: 0; color: #991b1b; font-size: 18px; font-weight: 700;">Reopen Grievance</h3>
                <p style="margin: 2px 0 0; color: #64748b; font-size: 12.5px;">Ticket will be escalated with high priority</p>
            </div>
        </div>

        <div style="margin-bottom: 12px;">
            <label style="font-size: 12.5px; font-weight: 600; color: #334155; margin-bottom: 6px; display: block;">Quick Reason:</label>
            <div style="display: flex; flex-wrap: wrap; gap: 6px;">
                <button type="button" class="preset-chip" onclick="setReopenReason('Work was only partially done; the underlying issue persists.')">Partially Done</button>
                <button type="button" class="preset-chip" onclick="setReopenReason('Issue reappeared within hours of repair.')">Reappeared</button>
                <button type="button" class="preset-chip" onclick="setReopenReason('Worker marked completed without visiting the site.')">No Site Visit</button>
                <button type="button" class="preset-chip" onclick="setReopenReason('Substandard quality of materials used.')">Substandard Fix</button>
            </div>
        </div>

        <label for="reopen-reason-text" style="font-size: 13px; font-weight: 600; color: #1e3a8a;">Detailed Explanation *</label>
        <textarea id="reopen-reason-text" rows="3" placeholder="Explain why the resolution was not satisfactory..." style="width: 100%; border-radius: 10px; border: 1.5px solid #cbd5e1; padding: 10px; font-family: inherit; font-size: 13.5px; box-sizing: border-box; margin-top: 4px; margin-bottom: 16px;"></textarea>

        <div style="display: flex; gap: 10px;">
            <button type="button" onclick="closeReopenModal()" style="flex: 1; padding: 10px; border: 1px solid #cbd5e1; background: white; border-radius: 8px; font-weight: 600; color: #64748b; cursor: pointer;">Cancel</button>
            <button type="button" id="btnSubmitReopen" onclick="submitReopenIssue()" style="flex: 2; padding: 10px; background: linear-gradient(135deg, #ef4444, #dc2626); color: white; border: none; border-radius: 8px; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);">
                <i class="fas fa-fire"></i> Reopen & Escalate Ticket
            </button>
        </div>
    </div>

    <script>
        window.currentUser = <%- JSON.stringify(typeof user !== 'undefined' ? user : {}) %>;
    </script>
    <script src="/user/js/citizen.js"></script>
    <script>
        let stream;

        // Start live camera
        // Start live camera
        async function startCamera() {
            const video = document.getElementById("cameraPreview");
            const captureBtn = document.getElementById("captureBtn");
            const locDisplay = document.getElementById("location-display");
            const locText = document.getElementById("loc-text");

            try {
                stream = await navigator.mediaDevices.getUserMedia({ video: true });
                video.srcObject = stream;
                video.style.display = "block";
                captureBtn.style.display = "inline-block";

                // Start fetching location immediately when camera opens
                if (navigator.geolocation) {
                    locDisplay.style.display = "inline-block";
                    locText.textContent = "Locating...";

                    navigator.geolocation.getCurrentPosition((pos) => {
                        const lat = pos.coords.latitude.toFixed(6);
                        const lng = pos.coords.longitude.toFixed(6);
                        locText.textContent = `${lat}, ${lng}`;

                        // Also pre-fill hidden inputs if available
                        const latInput = document.getElementById('photo-lat');
                        const lngInput = document.getElementById('photo-lng');
                        if (latInput) latInput.value = pos.coords.latitude;
                        if (lngInput) lngInput.value = pos.coords.longitude;
                    }, (err) => {
                        locText.textContent = "Location unavailable";
                    }, { enableHighAccuracy: true });
                }
            } catch (err) {
                alert("Camera access denied or unavailable");
            }
        }

        // Capture photo
        function capturePhoto() {
            const video = document.getElementById("cameraPreview");
            const canvas = document.getElementById("capturedImage");
            const hiddenInput = document.getElementById("issue-photo");

            const latInput = document.getElementById('photo-lat');
            const lngInput = document.getElementById('photo-lng');
            const locText = document.getElementById("loc-text"); // Get text element

            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;

            const ctx = canvas.getContext("2d");
            ctx.drawImage(video, 0, 0);

            const base64Image = canvas.toDataURL("image/jpeg");
            hiddenInput.value = base64Image;

            // Try to get geolocation when photo is captured
            if (navigator.geolocation) {
                // Use high accuracy if available; short timeout to avoid blocking too long
                navigator.geolocation.getCurrentPosition(function (position) {
                    if (latInput) latInput.value = position.coords.latitude || '';
                    if (lngInput) lngInput.value = position.coords.longitude || '';

                    // Update display text on capture to confirm what was saved
                    const lat = position.coords.latitude.toFixed(6);
                    const lng = position.coords.longitude.toFixed(6);
                    if (locText) locText.textContent = `${lat}, ${lng}`;

                    console.log('Captured location:', position.coords.latitude, position.coords.longitude);
                }, function (err) {
                    console.warn('Geolocation error or denied:', err.message);
                    if (latInput) latInput.value = '';
                    if (lngInput) lngInput.value = '';
                    if (locText) locText.textContent = "Location not saved";
                }, { enableHighAccuracy: true, timeout: 8000, maximumAge: 0 });
            } else {
                if (latInput) latInput.value = '';
                if (lngInput) lngInput.value = '';
            }

            // Detect face in the captured image (if supported by browser)
            try {
                const faceInput = document.getElementById('photo-has-face');
                if ('FaceDetector' in window) {
                    // Use the native FaceDetector API when available
                    createImageBitmap(canvas).then(bitmap => {
                        const detector = new FaceDetector({ fastMode: true, maxDetectedFaces: 1 });
                        detector.detect(bitmap).then(faces => {
                            const hasFace = Array.isArray(faces) && faces.length > 0;
                            if (faceInput) faceInput.value = hasFace ? 'true' : 'false';
                            console.log('FaceDetector result:', hasFace);
                        }).catch(err => {
                            console.warn('FaceDetector detection failed:', err);
                            if (faceInput) faceInput.value = '';
                        });
                    }).catch(err => {
                        console.warn('createImageBitmap failed:', err);
                        if (faceInput) faceInput.value = '';
                    });
                } else {
                    // Fallback: not supported — leave value empty so backend can decide
                    if (faceInput) faceInput.value = '';
                    console.log('FaceDetector API not supported in this browser');
                }
            } catch (e) {
                console.warn('Face detection error:', e);
            }

            // stop camera
            if (stream) stream.getTracks().forEach(track => track.stop());

            alert("Photo Captured!");
        }

        // ═══ DUPLICATE DETECTION & COMMUNITY VALIDATION ═══
        let _duplicateComplaintId = null;
        let _userLat = null, _userLng = null;
        let _pendingSubmitCallback = null;

        // Hook into the submit-complaint-btn to check for duplicates first
        (function hookDuplicateCheck() {
            function tryHook() {
                const submitBtn = document.getElementById('submit-complaint-btn');
                if (!submitBtn) return;

                // Store original onclick
                const originalOnClick = submitBtn.onclick;

                submitBtn.onclick = function(e) {
                    const latEl = document.getElementById('photo-lat');
                    const lngEl = document.getElementById('photo-lng');
                    const catEl = document.getElementById('issue-category');

                    if (latEl && lngEl && latEl.value && lngEl.value) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                        _userLat = parseFloat(latEl.value);
                        _userLng = parseFloat(lngEl.value);
                        const category = catEl ? catEl.value : '';
                        // Store the original action to call after modal decision
                        _pendingSubmitCallback = function() {
                            if (originalOnClick) originalOnClick.call(submitBtn, e);
                        };
                        checkForDuplicates(_userLat, _userLng, category);
                    } else {
                        // No lat/lng — just proceed normally
                        if (originalOnClick) originalOnClick.call(submitBtn, e);
                    }
                };
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', tryHook);
            } else {
                tryHook();
            }
        })();

        async function checkForDuplicates(lat, lng, category) {
            try {
                const res = await fetch('/complaints/check-duplicates', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ latitude: lat, longitude: lng, category })
                });

                if (!res.ok) {
                    if (_pendingSubmitCallback) { _pendingSubmitCallback(); _pendingSubmitCallback = null; }
                    return;
                }

                const data = await res.json();

                if (data.duplicates && data.duplicates.length > 0) {
                    const dup = data.duplicates[0];
                    _duplicateComplaintId = dup.complaint_id || dup.id;

                    const detailsDiv = document.getElementById('duplicateDetails');
                    if (detailsDiv) {
                        detailsDiv.innerHTML = `
                            <div style="margin-bottom:0.5rem;"><strong>Issue:</strong> ${dup.description ? dup.description.substring(0, 100) + '...' : 'Similar civic issue'}</div>
                            <div style="margin-bottom:0.5rem;"><strong>Category:</strong> ${dup.category || category}</div>
                            <div style="margin-bottom:0.5rem;"><strong>Filed:</strong> ${dup.created_at ? new Date(dup.created_at).toLocaleDateString('en-IN') : 'Recently'}</div>
                            <div style="margin-bottom:0.5rem;"><strong>Status:</strong> <span style="color:#f59e0b;font-weight:600;">${dup.status || 'Pending'}</span></div>
                            <div style="margin-bottom:0.5rem;"><strong>Community confirmations:</strong> ${dup.confirmations_count || 0}</div>
                            <div><strong>Distance:</strong> ~${Math.round((dup.distance_meters || 0))} metres away</div>
                        `;
                    }

                    const modal = document.getElementById('duplicateModal');
                    if (modal) {
                        modal.classList.remove('hidden');
                        modal.style.display = 'flex';
                    }
                } else {
                    // No duplicates — proceed with original submit
                    if (_pendingSubmitCallback) { _pendingSubmitCallback(); _pendingSubmitCallback = null; }
                }
            } catch (err) {
                console.warn('Duplicate check failed, submitting normally:', err);
                if (_pendingSubmitCallback) { _pendingSubmitCallback(); _pendingSubmitCallback = null; }
            }
        }

        async function confirmExistingComplaint() {
            if (!_duplicateComplaintId) return;

            try {
                const getPos = () => new Promise((resolve, reject) => {
                    if (!navigator.geolocation) return reject(new Error('Geolocation not supported'));
                    navigator.geolocation.getCurrentPosition(resolve, reject, { timeout: 10000 });
                });

                let userLat = _userLat, userLng = _userLng;
                try {
                    const pos = await getPos();
                    userLat = pos.coords.latitude;
                    userLng = pos.coords.longitude;
                } catch (_) { /* use stored coords */ }

                const res = await fetch(`/complaints/${_duplicateComplaintId}/confirm`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ user_latitude: userLat, user_longitude: userLng })
                });

                const data = await res.json();

                if (res.ok) {
                    // Close modal WITHOUT triggering pending form submit
                    const modal = document.getElementById('duplicateModal');
                    if (modal) {
                        modal.style.display = 'none';
                        modal.classList.add('hidden');
                    }
                    _pendingSubmitCallback = null;
                    _duplicateComplaintId = null;

                    const toast = document.createElement('div');
                    toast.style.cssText = 'position:fixed;bottom:2rem;right:2rem;z-index:99999;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;padding:1rem 1.5rem;border-radius:12px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,0.3);';
                    toast.innerHTML = '<i class="fas fa-check-circle"></i> Issue confirmed! This helps prioritise the fix.';
                    document.body.appendChild(toast);
                    setTimeout(() => toast.remove(), 4000);
                } else {
                    alert(data.message || 'Could not confirm. You may be too far from the issue location.');
                }
            } catch (err) {
                alert('Confirmation failed. Please try again.');
                console.error(err);
            }
        }

        function closeDuplicateModal() {
            const modal = document.getElementById('duplicateModal');
            if (modal) {
                modal.style.display = 'none';
                modal.classList.add('hidden');
            }
            // User chose "File New Complaint" — invoke the pending submit
            if (_pendingSubmitCallback) {
                const cb = _pendingSubmitCallback;
                _pendingSubmitCallback = null;
                cb();
            }
        }

        function showToast(message, type) {
            const colors = {
                success: 'linear-gradient(135deg,#10b981,#059669)',
                error: 'linear-gradient(135deg,#ef4444,#dc2626)',
                info: 'linear-gradient(135deg,#3b82f6,#2563eb)'
            };
            const toast = document.createElement('div');
            toast.style.cssText = `position:fixed;bottom:2rem;right:2rem;z-index:99999;background:${colors[type] || colors.info};color:#fff;padding:1rem 1.5rem;border-radius:12px;font-weight:600;box-shadow:0 8px 32px rgba(0,0,0,0.3);`;
            toast.textContent = message;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        async function quickConfirm(complaintId, lat, lng) {
            try {
                const res = await fetch(`/complaints/${complaintId}/confirm`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'include',
                    body: JSON.stringify({ user_latitude: lat, user_longitude: lng })
                });
                const data = await res.json();
                if (res.ok) {
                    showToast('✅ Issue confirmed! This helps prioritise the fix.', 'success');
                } else {
                    showToast(data.message || 'Could not confirm issue.', 'error');
                }
            } catch (err) {
                showToast('Confirmation failed. Please try again.', 'error');
            }
        }

        // Ultra Smooth 3D Specular Sheen & Interactive Glare for Cards
        (function init3DInteractiveCards() {
            const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (prefersReducedMotion) return;

            document.addEventListener('mousemove', function(e) {
                const target = e.target.closest('.smart-card, .complaint-card, .action-btn');
                if (!target) return;

                const rect = target.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                target.style.setProperty('--sheen-x', `${x}px`);
                target.style.setProperty('--sheen-y', `${y}px`);
            }, { passive: true });
        })();

        // Check for complaint submission success in URL
        (function checkComplaintSubmissionURL() {
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('complaintSuccess') === '1') {
                const complaintId = urlParams.get('complaintId');
                setTimeout(() => {
                    const msg = `🎉 Complaint #${complaintId || ''} successfully filed and routed to Municipal Field Team! Priority Score calculated.`;
                    if (typeof showToast === 'function') {
                        showToast(msg, 'success');
                    } else if (typeof showNotification === 'function') {
                        showNotification(msg, 'success');
                    }
                    const newUrl = window.location.pathname;
                    window.history.replaceState({}, document.title, newUrl);
                    if (typeof loadUserComplaints === 'function') loadUserComplaints();
                    const el = document.getElementById('all-complaints-container');
                    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }, 400);
            }
        })();

    </script>

    <!-- Duplicate Detection Modal -->
    <div id="duplicateModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.6);backdrop-filter:blur(6px);align-items:center;justify-content:center;" class="hidden">
      <div style="background:var(--glass-bg,rgba(255,255,255,0.1));backdrop-filter:blur(20px);border:1px solid rgba(255,255,255,0.2);border-radius:20px;padding:2rem;max-width:480px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,0.4);">
        <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.2rem;">
          <div style="width:48px;height:48px;background:linear-gradient(135deg,#f093fb,#f5576c);border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0;">
            <i class="fas fa-search-location" style="color:#fff;font-size:1.3rem;"></i>
          </div>
          <div>
            <h3 style="margin:0;font-size:1.1rem;font-weight:700;">Similar Issue Found Nearby!</h3>
            <p style="margin:0;font-size:0.82rem;opacity:0.7;">An active complaint exists within 500 metres of your location</p>
          </div>
        </div>
        <div id="duplicateDetails" style="background:rgba(255,255,255,0.05);border-radius:12px;padding:1rem;margin-bottom:1.2rem;font-size:0.88rem;line-height:1.6;"></div>
        <p style="font-size:0.85rem;opacity:0.8;margin-bottom:1.2rem;">
          <i class="fas fa-info-circle"></i> Confirming an existing issue is faster and helps prioritise it. 
          Only file a new complaint if your issue is different.
        </p>
        <div style="display:flex;gap:0.8rem;flex-wrap:wrap;">
          <button id="confirmExistingBtn" onclick="confirmExistingComplaint()" 
            style="flex:1;min-width:140px;padding:0.75rem 1rem;background:linear-gradient(135deg,#667eea,#764ba2);color:#fff;border:none;border-radius:10px;font-size:0.9rem;font-weight:600;cursor:pointer;">
            <i class="fas fa-thumbs-up"></i> Yes, I See This Too!
          </button>
          <button onclick="closeDuplicateModal()" 
            style="flex:1;min-width:140px;padding:0.75rem 1rem;background:rgba(255,255,255,0.1);color:inherit;border:1px solid rgba(255,255,255,0.2);border-radius:10px;font-size:0.9rem;cursor:pointer;">
            <i class="fas fa-plus"></i> File New Complaint
          </button>
        </div>
      </div>
    </div>

    <!-- AI Chatbot Widget -->
    <script src="/js/aiChatbot.js"></script>

</body>

