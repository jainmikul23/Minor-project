    <div id="report-issue-modal" class="modal">
        <form id="report-issue-form" class="modal-form" enctype="multipart/form-data" method="POST"
            action="/user/registerComplain">

            <span class="close-btn" onclick="closeReportModal()">&times;</span>
            <h3 style="margin-bottom: 20px; color: #1e3a8a;">Report an Issue</h3>

            <!-- Category -->
            <label for="issue-category">Category *</label>
            <select id="issue-category" name="category" required>
                <option value="">Select Category</option>
                <option value="Water Supply">Water Supply</option>
                <option value="Electricity">Electricity</option>
                <option value="Road Maintenance">Road Maintenance</option>
                <option value="Sanitation">Sanitation</option>
                <option value="Public Safety">Public Safety</option>
            </select>

            <!-- Department -->
            <label for="issue-department">Department *</label>
            <select id="issue-department" name="department" required>
                <option value="">Select Department</option>
                <option value="Water Supply">Water Supply</option>
                <option value="Electricity">Electricity</option>
                <option value="Road Maintenance">Road Maintenance</option>
                <option value="Public Health">Public Health</option>
                <option value="Sanitation">Sanitation</option>
            </select>

            <!-- Description with Ultra-Smooth Typewriter Animation & Quick Presets -->
            <div style="margin-top: 14px; margin-bottom: 6px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; flex-wrap: wrap; gap: 6px;">
                    <label for="issue-description" style="margin: 0; font-weight: 700; color: #1e3a8a;">
                        <i class="fas fa-pen-nib" style="color: #3b82f6; margin-right: 4px;"></i> Issue Description *
                    </label>
                    <span style="font-size: 11px; color: #64748b; font-style: italic;">
                        ⚡ Click any template to animate-type
                    </span>
                </div>
                <div class="quick-preset-chips" style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px;">
                    <button type="button" class="preset-chip" onclick="typewritePreset('pothole')">🕳️ Deep Pothole</button>
                    <button type="button" class="preset-chip" onclick="typewritePreset('streetlight')">💡 Streetlight Out</button>
                    <button type="button" class="preset-chip" onclick="typewritePreset('waterleak')">🚰 Water Pipeline Leak</button>
                    <button type="button" class="preset-chip" onclick="typewritePreset('garbage')">🗑️ Garbage Overflow</button>
                    <button type="button" class="preset-chip" onclick="typewritePreset('manhole')">⚠️ Broken Manhole</button>
                    <button type="button" class="preset-chip" onclick="typewritePreset('drainage')">🌊 Sewage Blockage</button>
                </div>
            </div>

            <div style="position: relative;">
                <textarea id="issue-description" name="description" required rows="4" 
                    placeholder="Describe your civic issue in detail..."
                    style="width: 100%; border-radius: 12px; border: 1.5px solid #cbd5e1; padding: 12px; font-family: inherit; font-size: 14px; line-height: 1.5; box-sizing: border-box; transition: all 0.2s ease;"></textarea>
                <div id="typewriter-indicator" style="display: none; position: absolute; bottom: 12px; right: 12px; font-size: 11.5px; color: #2563eb; background: rgba(239, 246, 255, 0.95); padding: 3px 9px; border-radius: 6px; font-weight: 600; pointer-events: none; border: 1px solid #bfdbfe; box-shadow: 0 2px 6px rgba(0,0,0,0.06);">
                    <i class="fas fa-keyboard fa-fade"></i> Typing...
                </div>
            </div>

            <!-- Smart AI Assist Polish Button -->
            <div style="display: flex; justify-content: flex-end; margin-top: 6px; margin-bottom: 14px;">
                <button type="button" onclick="polishWithAI()" class="ai-polish-btn" style="background: linear-gradient(135deg, #eff6ff 0%, #f5f3ff 100%); border: 1px solid #bfdbfe; color: #2563eb; padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: all 0.2s ease;">
                    <i class="fas fa-wand-magic-sparkles" style="color: #8b5cf6;"></i> AI Polish & Auto-Format Description
                </button>
            </div>

            <!-- REAL-TIME CAMERA CAPTURE -->
            <label>Take Photo </label>

            <video id="cameraPreview" autoplay playsinline
                style="width:100%; border-radius:8px; display:none; margin-bottom:10px;">
            </video>

            <canvas id="capturedImage" style="display:none;"></canvas>

            <div style="display:flex; gap:10px; margin-bottom:10px; align-items:center;">
                <button type="button" onclick="startCamera()" id="openCamBtn">Open Camera</button>
                <button type="button" onclick="capturePhoto()" id="captureBtn" style="display:none;">Capture</button>
                <p id="location-display" style="margin:0; font-size:0.9rem; color:#475569; display:none;">
                    <i class="fas fa-map-marker-alt"></i> <span id="loc-text">Fetching location...</span>
                </p>
            </div>

            <!-- Hidden input to store base64 image -->
            <input type="hidden" id="issue-photo" name="issuePhoto">
            <!-- Hidden inputs to store captured photo geolocation -->
            <input type="hidden" id="photo-lat" name="latitude">
            <input type="hidden" id="photo-lng" name="longitude">
            <!-- Hidden input to indicate whether the captured image contains a human face -->
            <input type="hidden" id="photo-has-face" name="hasFace">

            <!-- Pincode -->
            <label for="issue-pincode">Pincode *</label>
            <input type="text" id="issue-pincode" name="Pincode" required value="<%= user.Pincode %>">

            <!-- State -->
            <label for="issue-state">State *</label>
            <input type="text" id="issue-state" name="State" required value="<%= user.State %>">

            <!-- City -->
            <label for="issue-city">City *</label>
            <input type="text" id="issue-city" name="City" required value="<%= user.City %>">

            <!-- Address -->
            <label for="issue-address">Address Line (Optional)</label>
            <input type="text" id="issue-address" name="Address_Line" value="<%= user.Address_Line || '' %>">

            <!-- Submit -->
            <button type="button" id="submit-complaint-btn" onclick="submitComplaint(event)">
                Submit Complaint
            </button>

        </form>
    </div>

